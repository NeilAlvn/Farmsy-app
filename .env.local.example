# Farmsy mobile — client key staging file
# ----------------------------------------
# Copy this to `.env.local` (gitignored) and paste the values. Once filled,
# tell Chris and he distributes them into the files the apps actually read:
#   iOS     -> Farmsy/Secrets.plist        (gitignored)
#   Android -> android/secrets.properties  (gitignored)
#
# EVERY value here is a PUBLIC client key — safe to ship inside the app binary.
# NEVER paste a secret/server key here:
#   - RevenueCat SECRET key (sk_...)      -> server only, Aviah's side
#   - Supabase service_role key           -> server only
#   - the In-App Purchase .p8 file         -> goes straight into RevenueCat, not here

# --- RevenueCat (app.revenuecat.com -> Farmsy project -> API keys) ---
# Public app-specific SDK keys, one per platform.
REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Sentry (sentry.io -> farmsy org -> project settings -> Client Keys/DSN) ---
# Separate project per platform: farmsy-ios and farmsy-android. DSNs are public.
SENTRY_IOS_DSN=https://xxxx@oyyy.ingest.de.sentry.io/zzzz
SENTRY_ANDROID_DSN=https://xxxx@oyyy.ingest.de.sentry.io/zzzz


# --- PostHog (same project as the website — do NOT make a new one) ---
# Project API key + EU host. Shared so web + app are one user.
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://eu.i.posthog.com


# --- Google Maps (Android only; iOS uses Apple Maps) ---
# Already set in android/secrets.properties; include here only if it changes.
MAPS_API_KEY=
