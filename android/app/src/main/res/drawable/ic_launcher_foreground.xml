<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the 3D barn tile (same art as the iOS icon), inset 8%
     so the launcher mask cuts off the tile's own bevel and keeps the barn, tree and
     fields whole. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_art"
    android:inset="8%" />
