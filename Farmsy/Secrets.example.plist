<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy to Secrets.plist (gitignored) and fill in. All PUBLIC client keys —
	     safe to ship in the binary; secret/server keys must never appear here. -->

	<!-- RevenueCat public SDK key for the Farmsy iOS app (starts appl_). -->
	<key>RevenueCatPublicKey</key>
	<string>appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx</string>

	<!-- Sentry DSN for the farmsy-ios project (EU org). Public by design. -->
	<key>SentryDSN</key>
	<string>https://xxxx@oyyy.ingest.de.sentry.io/zzzz</string>

	<!-- PostHog: SAME project key as web (one project = one human across web+app),
	     EU host. -->
	<key>PostHogKey</key>
	<string>phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx</string>
	<key>PostHogHost</key>
	<string>https://eu.i.posthog.com</string>
</dict>
</plist>
