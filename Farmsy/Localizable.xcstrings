    "Claim it to keep your details up to date. Our team verifies every claim before handing over the keys.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Claim it to keep your details up to date. Our team verifies every claim before handing over the keys."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claim het om je gegevens actueel te houden. Ons team controleert elke claim voordat we de sleutels overhandigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réclamez-la pour garder vos informations à jour. Notre équipe vérifie chaque réclamation avant de remettre les clés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beanspruchen Sie ihn, um Ihre Daten aktuell zu halten. Unser Team überprüft jeden Anspruch, bevor die Schlüssel übergeben werden."
          }
        }
      }
    },
