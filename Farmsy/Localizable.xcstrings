          }
        }
      }
    },
    "And who may we thank?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "En wie mogen we bedanken?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Et qui devons-nous remercier ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Und wem dürfen wir danken?"
          }
        }
      }
    },
    "We use this only to keep your answers together and to write back if you asked something.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We gebruiken dit alleen om je antwoorden te bewaren en om terug te schrijven als je een vraag stelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous l’utilisons uniquement pour regrouper vos réponses et vous répondre si vous avez posé une question."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verwenden das nur, um Ihre Antworten zusammenzuhalten und zu antworten, falls Sie etwas gefragt haben."
          }
        }
      }
    },
