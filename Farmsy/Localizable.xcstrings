{
  "sourceLanguage": "en",
  "strings": {
    "“Found a cheese farm ten minutes from home. Fresher than the supermarket, and I know exactly who made it.”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "“Found a cheese farm ten minutes from home. Fresher than the supermarket, and I know exactly who made it.”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Een kaasboerderij gevonden op tien minuten van huis. Varser dan de supermarkt, en ik weet precies wie het gemaakt heeft.”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai trouvé une fromagerie à dix minutes de chez moi. Plus frais qu'au supermarché, et je sais exactement qui l'a fabriqué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Käsehof zehn Minuten von zu Hause gefunden. Frischer als im Supermarkt, und ich weiß genau, wer ihn gemacht hat."
          }
        }
      }
    },
