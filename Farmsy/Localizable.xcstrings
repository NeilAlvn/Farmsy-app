    "We check every report by hand and fix the listing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir prüfen jede Meldung von Hand und korrigieren den Eintrag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vérifions chaque signalement à la main et corrigeons la fiche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We controleren elke melding met de hand en passen de vermelding aan."
          }
        }
      }
    },
    "We could not find your account. Open the link from the email, or sign in first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten Ihr Konto nicht finden. Öffnen Sie den Link aus der E-Mail, oder melden Sie sich zuerst an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas trouvé votre compte. Ouvrez le lien de l’e-mail, ou connectez-vous d’abord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden je account niet vinden. Open de link uit de e-mail, of log eerst in."
          }
        }
      }
    },
    "We found %lld of %lld products at %lld farms within %lld km.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben %1$lld deiner %2$lld Produkte bei %3$lld Höfen im Umkreis von %4$lld km gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons trouvé %1$lld de vos %2$lld produits dans %3$lld fermes à moins de %4$lld km."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We vonden %lld van je %lld producten bij %lld boerderijen binnen %lld km."
          }
        }
      }
    },
    "We pick the farms, you drive once": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wir wählen die Höfe, du fährst einmal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "We pick the farms, you drive once"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous choisissons les fermes, vous ne roulez qu’une fois"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wij kiezen de boerderijen, jij rijdt één rondje"
          }
        }
      }
    },
    "We use this only to keep your answers together and to write back if you asked something.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir verwenden das nur, um Ihre Antworten zusammenzuhalten und zu antworten, falls Sie etwas gefragt haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous l’utilisons uniquement pour regrouper vos réponses et vous répondre si vous avez posé une question."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We gebruiken dit alleen om je antwoorden te bewaren en om terug te schrijven als je een vraag stelt."
          }
        }
      }
    },
    "We'll be in touch at %@ once the team has verified your claim.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir melden uns bei %@, sobald das Team Ihren Anspruch bestätigt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "We'll be in touch at %@ once the team has verified your claim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous contacterons à %@ une fois que l'équipe aura vérifié votre réclamation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We nemen contact met je op via %@ zodra het team je claim heeft geverifiëerd."
          }
        }
      }
    },
    "We've sent a verification link to %@. Click it to activate your account, then log in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
