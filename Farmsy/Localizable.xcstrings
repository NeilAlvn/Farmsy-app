    "📬 We've sent a verification link to your email — you can keep exploring in the meantime.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "📬 We've sent a verification link to your email — you can keep exploring in the meantime."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "📬 We hebben een verificatielink naar je e-mail gestuurd — in de tussentijd kun je blijven rondkijken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "📬 Wir haben einen Bestätigungslink an Ihre E-Mail gesendet — Sie können in der Zwischenzeit weiter erkunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "📬 Nous avons envoyé un lien de vérification à votre e-mail — vous pouvez continuer à explorer en attendant."
          }
        }
      }
    },
