          "stringUnit": {
            "state": "translated",
            "value": "Vous connaissez une ferme de producteurs qui n'est pas encore sur Farmsy ? Remplissez ce que vous savez — notre équipe vérifie chaque soumission avant publication."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennen Sie einen Hofladen, der noch nicht auf Farmsy ist? Teilen Sie uns mit, was Sie wissen — unser Team prüft jede Einreichung vor der Veröffentlichung."
          }
        }
      }
    },
