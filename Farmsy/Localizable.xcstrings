            "state": "translated",
            "value": "Wie als eerste een boerderij meldt, staat bovenaan."
          }
        }
      }
    },
    "The people who keep the map honest. Reports count; confirmations and photos earn badges.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leute, die die Karte ehrlich halten. Meldungen zählen; Bestätigungen und Fotos bringen Abzeichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceux qui gardent la carte honnête. Les signalements comptent ; les confirmations et les photos rapportent des badges."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mensen die de kaart eerlijk houden. Meldingen tellen; bevestigingen en foto's leveren badges op."
          }
        }
      }
    },
    "The product list couldn't be loaded. Check your connection and try again.": {
      "localizations": {
