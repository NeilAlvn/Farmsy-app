    "Deleting your account removes your profile, favourites and subscription data. Continue on your Farmsy account page, or write to hello@farmsy.app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Deleting your account removes your profile, favourites and subscription data. Continue on your Farmsy account page, or write to hello@farmsy.app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je account verwijderen verwijdert je profiel, favorieten en abonnementsgegevens. Ga verder op je Farmsy-accountpagina, of schrijf naar hello@farmsy.app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de votre compte supprime votre profil, vos favoris et vos données d'abonnement. Continuez sur votre page de compte Farmsy, ou écrivez à hello@farmsy.app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen Ihres Kontos entfernt Ihr Profil, Ihre Favoriten und Abonnementdaten. Fahren Sie auf Ihrer Farmsy-Kontoseite fort oder schreiben Sie an hello@farmsy.app."
          }
