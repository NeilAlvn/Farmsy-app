    "Full access — opening hours, contact details, photos and more for %@ and every other farm — is managed from your Farmsy account on the web.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Full access — opening hours, contact details, photos and more for %@ and every other farm — is managed from your Farmsy account on the web."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige toegang — openingstijden, contactgegevens, foto's en meer voor %@ en elke andere boerderij — wordt beheerd via je Farmsy-account op de website."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès complet — horaires, coordonnées, photos et plus pour %@ et toutes les autres fermes — est géré depuis votre compte Farmsy sur le web."
