    "Know a farm shop that isn't on Farmsy yet? Fill in what you know — our team checks every submission before it goes live.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennen Sie einen Hofladen, der noch nicht auf Farmsy ist? Teilen Sie uns mit, was Sie wissen — unser Team prüft jede Einreichung vor der Veröffentlichung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Know a farm shop that isn't on Farmsy yet? Fill in what you know — our team checks every submission before it goes live."
