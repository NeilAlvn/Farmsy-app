# Google Play service account credentials — grants API access to the Play
# listing. Must never reach git. (Named farmsy-<hex>.json by Google Cloud.)
farmsy-*.json
*service-account*.json
gcloud-*.json

# Billing and local drafts. This repo is PUBLIC — timesheets are billing data
# and reply drafts are private correspondence. They are written into the repo
# root as working files, so without these they sit one `git add -A` away from
# being published.
*Timesheet*
*timesheet*
*Reply*
*-draft*
